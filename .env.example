# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/luvo

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_REVIEW_CHAT_ID=-1003104024139

# AWS S3 / MinIO
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET_NAME=your_bucket_name
AWS_S3_ENDPOINT_URL=https://your-endpoint.com
AWS_S3_REGION=us-east-1

# Proxy (optional)
PROXY=

# RapidAPI
RAPIDAPI_KEY=your_rapidapi_key

# Mini App
MINI_APP_BASE_URL=https://your-mini-app-url.com

# JWT Token
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Placeholder для модерации
PLACEHOLDER_PHOTO_S3_KEY=profiles/PLACEHOLDER_PHOTO.jpg
PLACEHOLDER_NAME=*****
PLACEHOLDER_BIO=_

# SightEngine (face detection)
SIGHTENGINE_API_USER=your_api_user
SIGHTENGINE_API_SECRET=your_api_secret

# Admin import (optional)
IMPORT_FROM_S3_PASSWORD=

# Database management
SEED_DB=false
RESET_DB_ON_STARTUP=false

# Debug mode
DEBUG=false
